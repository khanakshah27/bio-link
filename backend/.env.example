# Copy to .env and fill in real values.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://biolink:biolink@localhost:5432/biolink

# NER model names (must already be `python -m spacy download <name>`'d,
# or, for scispacy, pip-installed per the README)
SCISPACY_MODEL=en_core_sci_sm
SPACY_FALLBACK_MODEL=en_core_web_sm

# Optional: raises your NCBI E-utilities rate limit from 3 to 10 req/sec
NCBI_API_KEY=

# Optional: enables an abstractive (Claude-written) paper summary instead
# of the built-in extractive summarizer. Leave blank to use the offline
# extractive summarizer.
ANTHROPIC_API_KEY=

# Keep "true" so the UI still shows example data for a few well-known
# genes/diseases when an external database is unreachable (offline demo,
# restricted network, brief outage). Set "false" to surface raw errors.
USE_OFFLINE_FALLBACK=true

REQUEST_TIMEOUT_SECONDS=8
MAX_UPLOAD_MB=20
CORS_ORIGINS=*
